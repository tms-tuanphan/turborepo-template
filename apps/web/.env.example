# Next.js web app (copy to apps/web/.env.local)
# Server-only vars — do not prefix with NEXT_PUBLIC_ unless the browser must read them.

# Nest API base URL (BFF proxies /api/session/* here)
API_BASE_URL=http://localhost:3000

# Must match apps/api cookie names
AUTH_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

# NextAuth (Auth.js v5)
AUTH_SECRET=change-me-min-32-characters-long-secret
NEXTAUTH_URL=http://localhost:3001
