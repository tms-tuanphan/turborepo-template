# NestJS API + Prisma (copy to apps/api/.env):
#   cp apps/api/.env.example apps/api/.env
#
# Prisma CLI also loads repo root .env (Docker vars only). DATABASE_URL lives here.

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/docs

# Database (Docker published port — see root .env POSTGRES_PORT)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/my_project

# Auth
JWT_SECRET=change-me-min-32-characters-long-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

# Seed (packages/database/prisma/seed.ts)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me

# Password reset (Mailtrap for local — https://mailtrap.io)
APP_URL=http://localhost:3001
# Locale segment for password-reset email links (matches apps/web defaultLocale)
ADMIN_AUTH_LOCALE=vi
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-user
SMTP_PASS=your-mailtrap-password
SMTP_FROM=noreply@example.com
