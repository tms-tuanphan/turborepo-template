# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001

# Swagger (off in production unless SWAGGER_ENABLED=true)
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/docs

# Database (packages/database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/my_project

# Auth
JWT_SECRET=change-me-min-32-characters-long-secret
AUTH_COOKIE_NAME=access_token

# Seed (packages/database/prisma/seed.ts)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me
