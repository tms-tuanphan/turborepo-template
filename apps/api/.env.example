# NestJS API + Prisma (copy to apps/api/.env):
#   cp apps/api/.env.example apps/api/.env
#
# Prisma CLI also loads repo root .env (Docker vars only). DATABASE_URL lives here.

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/docs

# Database (Docker published port — see root .env POSTGRES_PORT)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/my_project

# Auth
JWT_SECRET=change-me-min-32-characters-long-secret
AUTH_COOKIE_NAME=access_token

# Seed (packages/database/prisma/seed.ts)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me
