{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": [
    "API_BASE_URL",
    "AUTH_SECRET",
    "AUTH_URL",
    "AUTH_COOKIE_NAME",
    "ADMIN_DEMO_EMAIL",
    "ADMIN_DEMO_PASSWORD",
    "ADMIN_SEED_EMAIL",
    "ADMIN_SEED_PASSWORD",
    "DATABASE_URL",
    "JWT_SECRET",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "NODE_ENV",
    "CORS_ORIGIN",
    "PORT",
    "SWAGGER_ENABLED",
    "SWAGGER_PATH"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "test": {},
    "test:e2e": {}
  }
}
