# Infrastructure — Docker Compose only (copy to `.env` at repo root):
#   cp .env.example .env
#   docker compose up -d
#
# Application env (NestJS, Prisma CLI): apps/api/.env — see apps/api/.env.example

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=my_project
# Host port (5433 avoids conflict with local PostgreSQL on 5432)
POSTGRES_PORT=5433
