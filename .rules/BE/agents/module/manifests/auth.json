{
  "schemaVersion": 1,
  "id": "auth",
  "displayName": "Auth API",
  "scope": {
    "moduleRoot": "apps/api/src/auth",
    "contractRoot": "packages/api/src/auth",
    "databaseModels": ["packages/database/prisma/schema.prisma"],
    "controllers": ["apps/api/src/auth/auth.controller.ts"],
    "services": ["apps/api/src/auth/auth.service.ts"],
    "tests": [
      "apps/api/src/auth/auth.service.spec.ts",
      "apps/api/src/auth/auth.controller.spec.ts"
    ]
  },
  "allowedImports": [
    "apps/api/src/prisma/**",
    "packages/api/src/auth/**",
    "packages/api/src/common/**",
    "@repo/api/**",
    "@repo/database/**"
  ],
  "forbiddenRoots": ["apps/web/**"],
  "relatedRules": [
    ".rules/BE/rules/be-nestjs-structure.mdc",
    ".rules/BE/rules/be-production.mdc",
    ".rules/BE/rules/be-prisma.mdc",
    ".rules/BE/rules/be-swagger-openapi.mdc",
    ".rules/shared/rules/error-contract.mdc"
  ]
