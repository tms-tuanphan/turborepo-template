{
  "schemaVersion": 1,
  "id": "auth",
  "displayName": "Auth API",
  "scope": {
    "moduleRoot": "apps/api/src/auth",
    "contractRoot": "packages/api/src/auth",
    "databaseModels": ["packages/database/prisma/schema.prisma"],
    "controllers": ["apps/api/src/auth/controllers/auth.controller.ts"],
    "services": [
      "apps/api/src/auth/services/auth.service.ts",
      "apps/api/src/auth/services/password-reset.service.ts"
    ],
    "tests": [],
    "swagger": [
      "apps/api/src/swagger/setup-swagger.ts",
      "apps/api/src/main.ts"
    ]
  },
  "allowedImports": [
    "apps/api/src/prisma/**",
    "packages/api/src/auth/**",
    "packages/api/src/common/**",
