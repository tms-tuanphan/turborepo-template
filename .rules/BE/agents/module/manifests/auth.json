  "relatedDocs": [
    ".rules/BE/docs/API_AUTH_DESIGN.md",
    ".rules/shared/skills/admin-auth-forgot-password-sync/SKILL.md",
    ".rules/shared/skills/admin-auth-register-sync/SKILL.md"
  ],
  "notes": "Layered layout: controllers/, services/, guards/, decorators/, strategies/, interfaces/, mail/, utils/."
