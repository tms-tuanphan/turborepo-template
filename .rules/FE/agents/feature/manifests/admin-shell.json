{
  "id": "admin-shell",
  "displayName": "Admin Shell Layout",
  "scope": {
    "featureRoot": "apps/web/features/admin-shell",
    "publicApi": "apps/web/features/admin-shell/index.ts",
    "routes": [
      "apps/web/app/[locale]/(admin)/admin/(main)/layout.tsx",
      "apps/web/app/[locale]/(admin)/layout.tsx"
    ],
    "apiRoutes": []
