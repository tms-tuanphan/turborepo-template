  "allowedImports": [
    "apps/web/shared/**",
    "apps/web/core/**",
    "apps/web/components/ui/**",
    "@repo/ui/**",
    "@repo/api/client",
    "@repo/shared-validation"
  ],
  "forbiddenRoots": [
    "apps/web/features/blogs",
    "apps/web/features/admin-blogs"
  ],
  "relatedDocs": [
    ".rules/FE/docs/04-feature-module.md",
    ".rules/BE/docs/API_AUTH_DESIGN.md",
    ".rules/shared/skills/admin-auth-register-sync/SKILL.md"
  ]
}
