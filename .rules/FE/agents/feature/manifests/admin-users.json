{
  "id": "admin-users",
  "displayName": "Admin Users Management",
  "scope": {
    "featureRoot": "apps/web/features/admin-users",
    "publicApi": "apps/web/features/admin-users/index.ts",
    "routes": [
      "apps/web/app/[locale]/(admin)/admin/(main)/users/**"
    ],
    "apiRoutes": ["apps/web/app/api/admin/users/**"],
    "serverActions": ["apps/web/features/admin-users/actions/**"]
